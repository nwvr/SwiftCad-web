( 1 um SCMOS demo. 1 DBU = 0.01 um, lambda = 50 (0.5 um), min drawn = 2L = 1 um. );
( Layers: NWELL ACTIVE NPLUS PPLUS POLY CONT MET1 VIA MET2 );
( Standard cells are 64L tall with MET1 VSS/VDD rails for abutment. );

( --- litho alignment: nested frames, cross, vernier, circular target --- );
DS 1 1 1;
9 ALIGN;
L NWELL;
B 5600 5600 0 0;
L ACTIVE;
B 4800 200 0 2300;
B 4800 200 0 -2300;
B 200 4800 2300 0;
B 200 4800 -2300 0;
B 800 800 0 0;
L POLY;
B 3400 150 0 1625;
B 3400 150 0 -1625;
B 150 3400 1625 0;
B 150 3400 -1625 0;
L MET1;
B 2200 150 0 0;
B 150 2200 0 0;
B 80 500 2000 800;
B 80 500 2160 800;
B 80 500 2320 800;
B 80 500 2480 800;
B 80 500 2640 800;
B 80 500 2800 800;
B 80 400 2000 -800;
B 80 450 2160 -800;
B 80 500 2320 -800;
B 80 550 2480 -800;
B 80 600 2640 -800;
L VIA;
B 100 100 0 0;
L MET2;
B 900 150 0 375;
B 900 150 0 -375;
B 150 900 375 0;
B 150 900 -375 0;
R 500 0 0;
DF;

DS 2 1 1;
9 TAP_P;
L ACTIVE;
B 200 200 0 0;
L PPLUS;
B 300 300 0 0;
L CONT;
B 100 100 0 0;
L MET1;
B 200 200 0 0;
DF;

DS 3 1 1;
9 TAP_N;
L NWELL;
B 400 400 0 0;
L ACTIVE;
B 200 200 0 0;
L NPLUS;
B 300 300 0 0;
L CONT;
B 100 100 0 0;
L MET1;
B 200 200 0 0;
DF;

( --- INV 10L x 64L: poly crosses n/p active, rails, taps --- );
DS 4 1 1;
9 INV;
L NWELL;
B 500 1750 250 2325;
L ACTIVE;
B 300 700 250 800;
B 300 900 250 2400;
B 200 200 420 150;
B 200 200 420 3050;
L NPLUS;
B 380 800 250 800;
B 280 280 420 3050;
L PPLUS;
B 380 1000 250 2400;
B 280 280 420 150;
L POLY;
B 100 2700 250 1650;
L CONT;
B 100 100 140 800;
B 100 100 360 800;
B 100 100 140 2400;
B 100 100 360 2400;
B 100 100 420 150;
B 100 100 420 3050;
L MET1;
B 500 200 250 100;
B 500 200 250 3100;
B 100 750 140 475;
B 100 750 140 2725;
B 100 1700 360 1600;
B 200 200 420 150;
B 200 200 420 3050;
DF;

( --- NAND2 16L: series NMOS, parallel PMOS --- );
DS 5 1 1;
9 NAND2;
L NWELL;
B 800 1750 400 2325;
L ACTIVE;
B 600 700 400 800;
B 600 900 400 2400;
B 200 200 700 150;
B 200 200 700 3050;
L NPLUS;
B 680 800 400 800;
B 280 280 700 3050;
L PPLUS;
B 680 1000 400 2400;
B 280 280 700 150;
L POLY;
B 100 2700 250 1650;
B 100 2700 550 1650;
L CONT;
B 100 100 120 800;
B 100 100 680 800;
B 100 100 120 2400;
B 100 100 400 2400;
B 100 100 680 2400;
B 100 100 700 150;
B 100 100 700 3050;
L MET1;
B 800 200 400 100;
B 800 200 400 3100;
B 100 750 120 475;
B 100 750 120 2725;
B 100 750 680 2725;
B 100 1700 680 1600;
B 320 100 540 2400;
B 200 200 700 150;
B 200 200 700 3050;
DF;

( --- MOS varactor / cap: fingered poly over n-active in nwell --- );
DS 6 1 1;
9 MOSCAP;
L NWELL;
B 2200 1600 0 0;
L ACTIVE;
B 1800 1000 0 0;
L NPLUS;
B 2000 1200 0 0;
L POLY;
B 150 1200 -600 0;
B 150 1200 -300 0;
B 150 1200 0 0;
B 150 1200 300 0;
B 150 1200 600 0;
B 1600 150 0 675;
L CONT;
B 100 100 -900 0;
B 100 100 900 0;
B 100 100 -600 675;
B 100 100 0 675;
B 100 100 600 675;
L MET1;
B 300 300 -900 0;
B 300 300 900 0;
B 1600 200 0 675;
DF;

( --- silicide-block style poly resistor, 2L width --- );
DS 7 1 1;
9 PRES;
L POLY;
W 100 -1200 600 1200 600;
W 100 1200 600 1200 300;
W 100 1200 300 -1200 300;
W 100 -1200 300 -1200 0;
W 100 -1200 0 1200 0;
W 100 1200 0 1200 -300;
W 100 1200 -300 -1200 -300;
W 100 -1200 -300 -1200 -600;
W 100 -1200 -600 1200 -600;
L CONT;
B 100 100 -1200 600;
B 100 100 1200 -600;
L MET1;
B 300 300 -1200 600;
B 300 300 1200 -600;
DF;

( --- 40 um bond pad, 3x3 via array --- );
DS 8 1 1;
9 PAD;
L MET1;
B 3400 3400 0 0;
L VIA;
B 150 150 -800 -800;
B 150 150 0 -800;
B 150 150 800 -800;
B 150 150 -800 0;
B 150 150 0 0;
B 150 150 800 0;
B 150 150 -800 800;
B 150 150 0 800;
B 150 150 800 800;
L MET2;
B 4000 4000 0 0;
DF;

( --- NOR2 16L: parallel NMOS, series PMOS --- );
DS 9 1 1;
9 NOR2;
L NWELL;
B 800 1750 400 2325;
L ACTIVE;
B 600 700 400 800;
B 600 900 400 2400;
B 200 200 700 150;
B 200 200 700 3050;
L NPLUS;
B 680 800 400 800;
B 280 280 700 3050;
L PPLUS;
B 680 1000 400 2400;
B 280 280 700 150;
L POLY;
B 100 2700 250 1650;
B 100 2700 550 1650;
L CONT;
B 100 100 120 800;
B 100 100 400 800;
B 100 100 680 800;
B 100 100 120 2400;
B 100 100 680 2400;
B 100 100 700 150;
B 100 100 700 3050;
L MET1;
B 800 200 400 100;
B 800 200 400 3100;
B 100 750 120 475;
B 100 750 400 475;
B 320 100 260 800;
B 100 750 120 2725;
B 100 1700 680 1600;
B 200 200 700 150;
B 200 200 700 3050;
DF;

( --- filler / tap cell, 8L --- );
DS 10 1 1;
9 FILL;
